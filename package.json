{
  "name": "habitguard",
  "version": "1.0.0",
  "description": "HabitGuard — Predictive Habit Intelligence Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.habitguard.app",
    "productName": "HabitGuard",
    "directories": {
      "output": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/assets/icons/icon.png"
    }
  },
  "keywords": ["habit", "tracker", "prediction", "productivity", "electron"],
  "author": "Sachin",
  "license": "MIT",
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.9.0"
  }
}
